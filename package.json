{
  "name": "our-mailbox",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "dev:vinext": "vinext dev --host 127.0.0.1 --port 3000",
    "setup:local": "tsx scripts/setup-local.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:local": "node --import ./scripts/register-tests.mjs --test tests/*.test.ts",
    "sprites:animals": "node scripts/build-animal-sprites.mjs",
    "sprites:stamps": "node scripts/build-stamps.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:send-browser": "node --import ./scripts/register-tests.mjs --test tests/send.browser.e2e.ts",
    "build:cloudflare": "vinext build",
    "preview:cloudflare": "node scripts/prepare-worker-preview.mjs && wrangler dev --config dist/server/wrangler.json --port 3000",
    "deploy:cloudflare": "wrangler deploy --config dist/server/wrangler.json",
    "hash-passcode": "tsx scripts/hash-passcode.ts",
    "aging": "tsx scripts/inspect-aging.ts",
    "export:local": "tsx scripts/export-local.ts",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:worker": "node scripts/verify-worker.mjs",
    "verify:worker-config": "node scripts/verify-worker-config.mjs",
    "db:migrate:local": "wrangler d1 migrations apply MAILBOX_DB --local --config wrangler.jsonc",
    "db:migrate:production": "wrangler d1 migrations apply MAILBOX_DB --remote --config wrangler.jsonc",
    "import:local": "node scripts/import-letters.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "jose": "^6.2.11",
    "jspdf": "^4.2.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "next": "^16.3.4",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "0.35.4",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
